# Banco de dados (SQLite local, arquivo criado automaticamente)
DATABASE_URL="file:./dev.db"

# Porta da API
PORT=3333

# Origem(s) permitida(s) para CORS (frontend). Separe múltiplas por vírgula.
CORS_ORIGIN="http://localhost:5173"

# ---- Gestão de Performance: alertas de prazos e KPIs ----
# Dias de antecedência para avisar que o prazo de uma tarefa/projeto está a terminar
ALERT_DUE_SOON_DAYS=3
# De quantos em quantos minutos a API verifica alertas novos (0 desliga)
ALERT_CHECK_INTERVAL_MINUTES=60
# Opcional: URL de Incoming Webhook do Microsoft Teams (ou Slack) para receber
# os alertas novos fora do painel. Deixe vazio para usar só o painel web.
ALERT_WEBHOOK_URL=""
# Severidade mínima enviada ao webhook: CRITICAL | WARNING | INFO
ALERT_WEBHOOK_MIN_SEVERITY="WARNING"

# ---- Login ----
# Duração de cada sessão, em horas. No primeiro acesso, o ecrã de login pede
# para criar o administrador.
SESSION_TTL_HOURS=12
